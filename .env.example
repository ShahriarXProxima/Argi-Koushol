# ==============================================================================
# Agri-Koushol Environment Variables (.env.example)
# Autonomous AI Farm Platform
# ==============================================================================

# Database & Supabase
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# External APIs & LLM
OPENWEATHER_API_KEY="your-openweather-api-key"
GEMINI_API_KEY="your-gemini-api-key"
LLM_MODEL="gemini-2.5-flash"

# MCP Server
MCP_SERVER_URL="http://localhost:3001"
MCP_PORT="3001"
MCP_TOKEN="your-mcp-token"

# Automation & Webhooks
INGEST_API_KEY="your-internal-ingest-api-key"
N8N_WEBHOOK_URL="https://n8n.example.com/webhook/agri-koushol"
N8N_SHARED_SECRET="your-n8n-shared-secret"
USE_N8N="false"

# Notifications & Alerts (WhatsApp)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
FARMER_WHATSAPP_TO="whatsapp:+8801700000000"
